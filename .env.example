# =================================================================
# Configuration OWASP ZAP Scanner
# =================================================================
# Copiez ce fichier en '.env' et configurez vos valeurs locales :
# cp .env.example .env

# Clé API OWASP ZAP (la même que celle configurée dans ZAP ou start_zap.bat)
ZAP_API_KEY=your_zap_api_key_here

# Hôte et Port de l'API OWASP ZAP (par défaut 127.0.0.1:8080)
ZAP_HOST=127.0.0.1
ZAP_PORT=8080

# Configuration du serveur Web Flask
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=False
